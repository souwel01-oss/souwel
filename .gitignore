# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which is the one env file that MUST be committed.
# It holds placeholders only — no real credentials — and it is how anyone
# setting the project up (or configuring Vercel) knows which variables exist.
# Without this exception `.env*` swallows it and the required variables become
# tribal knowledge.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# `vercel link` appends its own `.vercel` and `.env*` here, and gitignore is
# order-sensitive — the LAST matching rule wins, so those duplicates silently
# cancelled the `!.env.example` exception above. Both patterns are already
# covered further up, so the exception is simply restated after them. Expect
# the CLI to append them again on a future link; keep this line last.
!.env.example

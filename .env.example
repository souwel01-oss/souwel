# Copy to .env.local and fill in. Never commit .env.local.

# --- Database (Supabase PostgreSQL) ---
# Pooled connection — used by the app at runtime
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection — used by Prisma migrations
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Google OAuth ("Continue with Google") ---
# console.cloud.google.com -> APIs & Services -> Credentials
#   -> Create OAuth client ID -> Web application
# Authorised redirect URI (add one line per environment):
#   http://localhost:3000/api/auth/callback/google
#   https://YOUR-DOMAIN/api/auth/callback/google
# Leave both blank and the Google button is not rendered at all — the app
# still runs, and email/password sign-in is unaffected.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Apple OAuth ("Continue with Apple") ---
# developer.apple.com -> Certificates, Identifiers & Profiles
#   1. Identifiers -> App ID, enable "Sign in with Apple"
#   2. Identifiers -> Services ID  <- THIS is APPLE_CLIENT_ID (e.g. com.souwel.web)
#   3. Keys -> new key with "Sign in with Apple" -> downloads a .p8 file
# Return URL to register against the Services ID:
#   https://YOUR-DOMAIN/api/auth/callback/apple
#
# APPLE_CLIENT_SECRET IS NOT A PASSWORD. Apple has no copy-and-paste secret:
# it is an ES256 JWT that you sign yourself from the .p8 key, and Apple caps
# its lifetime at SIX MONTHS. Put a reminder in the calendar — when it expires,
# "Continue with Apple" starts failing and nothing else changes.
# Apple also requires HTTPS for the return URL, so this provider cannot be
# tested on http://localhost.
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
# Only needed if a native iOS app ever shares this backend.
APPLE_BUNDLE_IDENTIFIER=""

# --- Transactional email (verification + password reset) ---
# Without BOTH of these, the links are printed to the server console instead of
# being sent, and email verification is NOT required to sign in — otherwise new
# customers would be locked out of accounts they just created. See lib/auth/email.ts.
RESEND_API_KEY=""
AUTH_EMAIL_FROM="Souwel <no-reply@your-domain.com>"

# --- Cloudinary ---
# Server-only. NEVER prefix the secret with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Safe to expose — used by the client-side image loader
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
